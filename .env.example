# vision-patrol node — 环境变量模板
# 复制为 .env 后按需修改；run.py 启动时会自动读取同目录 .env。
# 标 [必填] 的项缺失会直接让进程启动失败并打印缺少的 key。

# --- 运行模式 ---------------------------------------------------------------
# 日志落盘目录（留空则只输出到 stdout；容器里通常挂 /app/logs）
# LOG_DIR=/app/logs

# --- 流式队列（Redis Streams）------------------------------------------------
# [必填] standalone | cluster
STREAM_MODE=standalone

# standalone 模式下的连接信息（cluster 模式忽略这三项）
# [必填]
STREAM_HOST=stream.internal
# [必填]
STREAM_PORT=6379
# [必填] 逻辑库编号
STREAM_DB=2

# 无认证时留空
STREAM_USER=
STREAM_TOKEN=

# [必填] 消费组名；同一批实例填相同值
STREAM_GROUP=patrol-runners
# 消费成员名，多实例必须互不相同；留空自动用 <hostname>-<pid>
STREAM_MEMBER=runner-a-01

# [必填] 待消费的队列名（单个）
JOB_TOPIC=vision:capture:queue
# 多分片队列时改用逗号分隔，优先于 JOB_TOPIC
# JOB_TOPIC_LIST=vision:capture:queue:{0},vision:capture:queue:{1}
# 汇总队列名，缺省 patrol:digest:queue
# DIGEST_TOPIC=patrol:digest:queue

# --- 租约与重试 --------------------------------------------------------------
# [必填] 处理权租约 key 前缀；需与队列落在同一 slot
LEASE_PREFIX=lease:jobs:
# [必填] 租约 TTL 秒数；续期节奏固定为 TTL/3
LEASE_TTL_SEC=30
# [必填] pending 消息空闲多久后可被其他成员接管（毫秒），需 > LEASE_TTL_SEC*1000
STALE_AFTER_MS=10000
# 无新消息时的阻塞读时长（毫秒）
POLL_BLOCK_MS=3000
# 单条消息最多投递几次，超出后进死信
JOB_MAX_DELIVERIES=3
# 租约续期次数上限，0 表示不限；最大占用时长 ≈ TTL/3 × (N+1)
LEASE_MAX_RENEWALS=3

# --- 并发 -------------------------------------------------------------------
# process=进程池（CPU 密集的视觉推理，建议 核数-1）
# thread=线程池（纯 HTTP 转发的 IO 等待型，可开 4~8）
PIPELINE_RUN_MODE=process
PIPELINE_WORKERS=1
# 汇总任务只读库+发 HTTP，固定走独立线程池，不占视觉进程池
DIGEST_WORKERS=4
# 每轮拉取条数，一般与 PIPELINE_WORKERS 一致
POLL_COUNT=1

# --- 结果账本（MySQL）--------------------------------------------------------
# [必填]
LEDGER_HOST=ledger.internal
LEDGER_PORT=3306
# [必填]
LEDGER_USER=patrol_writer
# 免密环境留空
LEDGER_TOKEN=
# [必填]
LEDGER_SCHEMA=vision_patrol

# --- 视觉推理 ---------------------------------------------------------------
# 权重目录；缺失时自动拉取
BUNDLE_DIR=./models
# [必填] 总开关：false 时所有 vision.* 作业跳过本地推理，直接转下游
VISION_ENABLED=true
# 分项开关，仅在总开关为 true 时生效
VISION_SUBJECT_ENABLED=true
VISION_DIFF_ENABLED=true

# --- 下游工作流（HTTP Webhook）----------------------------------------------
# [必填] 单条作业转交地址
WORKFLOW_WEBHOOK_URL=https://workflow.example.internal/triggers/webhook/change-token
# 只等 HTTP 受理回执，不等业务处理完成
WORKFLOW_ACK_TIMEOUT_SEC=10

# 汇总作业的地址；URLS 优先于 URL，多地址时按下述策略分流
DIGEST_WORKFLOW_URL=https://workflow.example.internal/triggers/webhook/digest-token
# DIGEST_WORKFLOW_URLS=https://w1.example.internal/…,https://w2.example.internal/…
DIGEST_WORKFLOW_TIMEOUT_SEC=60
DIGEST_WORKFLOW_MAX_INFLIGHT=4
DIGEST_WORKFLOW_RETRIES=2
# round_robin | random
DIGEST_WORKFLOW_BALANCE=round_robin
# 连续失败几次后熔断
DIGEST_WORKFLOW_FAILURE_THRESHOLD=5
# 熔断冷却秒数
DIGEST_WORKFLOW_COOLDOWN_SEC=60

# --- 回调补偿扫描 -----------------------------------------------------------
# 作业转交后账本置 4；若回调方长时间不写回，由扫描器兜底置 9
SWEEP_ENABLED=true
# 建议取下游平均处理时长（分钟）× 3
SWEEP_STALE_MINUTES=5
SWEEP_INTERVAL_SEC=60

# --- 集群模式（STREAM_MODE=cluster）----------------------------------------
# STREAM_CLUSTER_NODES=10.0.0.11:7000,10.0.0.12:7001,10.0.0.13:7002
